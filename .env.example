# OpenAI API key used by the agent (required)
OPENAI_API_KEY=sk-...

# Model used for investigations (must be accessible to the key above)
MENTAL_MODEL_LLM=gpt-5.6-sol
MENTAL_MODEL_REASONING_EFFORT=medium
ALLOW_LOCAL_REPOS=true
MAX_TOTAL_REPOSITORIES=9
GIT_CLONE_TIMEOUT_SECONDS=120
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_FAILURE_LIMIT=5
ASK_RATE_LIMIT=20

# Password required to access the app (leave empty to disable the gate)
APP_PASSWORD=change-me

# Optional GitHub token for higher API limits and private repository context
GITHUB_TOKEN=
